# Backend-only environment (DB, auth, server)
API_PORT=4000
AUTH_SECRET=change-me
# Set to true to skip API auth (pair with frontend AUTH_DISABLED / NEXT_PUBLIC_AUTH_DISABLED)
AUTH_DISABLED=true
CORS_ORIGIN=http://localhost:3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=defence
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable
# Optional:
# PG_AUTH_TABLE=Defenceusers
# PGPOOL_MAX=20
# COOKIE_SAME_SITE=none   # required when frontend and API are on different sites (not localhost)
