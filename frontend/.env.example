# Frontend-only environment
# Browser-facing backend origin (no /api suffix, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match backend AUTH_SECRET (Next.js proxy verifies session cookie for page gates)
AUTH_SECRET=change-me

# Set both to true to skip login (pair with backend AUTH_DISABLED=true)
# AUTH_DISABLED — page proxy (server). NEXT_PUBLIC_AUTH_DISABLED — client 401 redirects.
AUTH_DISABLED=false
NEXT_PUBLIC_AUTH_DISABLED=false
