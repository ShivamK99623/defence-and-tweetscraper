# Search defaults (CLI flags override these)
QUERY=Operation Sindoor (martyr OR controversy OR pension OR Agniveer OR fake OR denial OR Rafale)
SINCE=2025-05-01
UNTIL=2025-05-15
PRODUCT=Latest
OUT=tweets-parsed.json

# User timeline (twitter-user.js)
# Note: do not use USER= — that is the OS login name on macOS/Linux
TWITTER_USER=narendramodi
HANDLE=narendramodi
USER_OUT=user-tweets.json
USER_PAGES=3

# Shared
PAGES=3
COUNT=20
DELAY_MS=1500
# RAW_DIR=twitter-raw
